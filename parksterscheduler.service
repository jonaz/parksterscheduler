#
# sudo useradd -r -s /bin/false parksterscheduler
# sudo mkdir -p /opt/parksterscheduler/tls
# sudo chown -R parksterscheduler:parksterscheduler /opt/parksterscheduler
# sudo chmod 600 /opt/parksterscheduler/config.env /opt/parksterscheduler/config.json /opt/parksterscheduler/tls/server.key
#
[Unit]
Description=Parkster Car Changer Service
# Ensures the network is fully available before starting
After=network-online.target
Wants=network-online.target

[Service]
# The user and group that will run the service
User=parksterscheduler
Group=parksterscheduler

# The type of service
Type=simple

# The working directory for the binary and config.json
WorkingDirectory=/opt/parksterscheduler

# Creates /var/lib/parksterscheduler for statePath (last known Tesla state)
StateDirectory=parksterscheduler

# Credentials only; everything else is in config.json
EnvironmentFile=/opt/parksterscheduler/config.env

ExecStart=/opt/parksterscheduler/parksterscheduler -config /opt/parksterscheduler/config.json

# Automatically restart the service if it fails
Restart=on-failure
RestartSec=10s

[Install]
# Enable the service to start at boot
WantedBy=multi-user.target
